<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Extension -->
    <record id="crm_lead_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Make the Expected Revenue field big, bold and green -->
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="style">font-size: 24px !important; color: #21b799 !important; font-weight: 800 !important;</attribute>
            </xpath>

            <!-- Show custom_product (Product Interest) right beside/under title/contact fields -->
            <xpath expr="//field[@name='contact_name']" position="before">
                <field name="custom_product" string="Product Interest"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="custom_type_of_business" string="Type of Business"/>
                <field name="custom_territory" string="Territory"/>
                <field name="custom_technician" string="Technician Assigned"/>
                <field name="custom_quote" string="Quote Status"/>
                <field name="custom_quote_date" string="Quote Date"/>
                <field name="custom_demo_done" string="Demo Done"/>
                <field name="custom_deal_size" string="Deal Size"/>
                <field name="legacy_create_date" string="Legacy Created On" readonly="1"/>
                <field name="last_todo_note" string="Last To-Do / Note" readonly="1"/>
            </xpath>

            <!-- Enable column toggle/picker by adding optional attributes to fields in Imported To-Dos list -->
            <xpath expr="//notebook" position="inside">
                <page string="Imported To-Dos" name="imported_todos">
                    <field name="todo_ids">
                        <list string="To-Dos" editable="bottom">
                            <field name="name" string="Subject"/>
                            <field name="status" optional="show"/>
                            <field name="date" optional="show"/>
                            <field name="allocated_to" optional="show"/>
                            <field name="legacy_create_date" string="Original Creation Date" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Tree / List View Extension to show Last To-Do Note -->
    <record id="crm_lead_view_tree_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="last_todo_note" string="Last To-Do / Note" optional="show"/>
                <field name="custom_product" string="Product Interest" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Opportunities Tree View Extension as well -->
    <record id="crm_opportunity_view_tree_inherit_custom" model="ir.ui.view">
        <field name="name">crm.opportunity.tree.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="last_todo_note" string="Last To-Do / Note" optional="show"/>
                <field name="custom_product" string="Product Interest" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
