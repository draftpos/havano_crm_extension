<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legacy_data_import_wizard" model="ir.ui.view">
        <field name="name">legacy.data.import.wizard.form</field>
        <field name="model">legacy.data.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Legacy Data">
                <field name="state" invisible="1"/>
                
                <group invisible="state != 'upload'">
                    <field name="import_type" widget="radio"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>

                <group invisible="state != 'importing'">
                    <field name="total_count" readonly="1"/>
                    <field name="imported_count" readonly="1"/>
                    <field name="progress" widget="progressbar"/>
                </group>

                <footer>
                    <button name="action_import_data" type="object" string="Start Import" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import_data" type="object" string="Continue Import" class="btn-primary" invisible="state != 'importing'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_legacy_data_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Legacy Data (Excel)</field>
        <field name="res_model">legacy.data.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add menu item under CRM Configuration -->
    <menuitem id="menu_legacy_data_import"
              name="Import Legacy Data"
              parent="crm.crm_menu_config"
              action="action_legacy_data_import_wizard"
              sequence="100"/>
</odoo>
